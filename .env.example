PORT=5000

MONGO_URI=your_mongodb_connection_string

JWT_SECRET=your_jwt_secret

OPENAI_API_KEY=your_openai_api_key

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

FRONTEND_URL=https://your-domain.com

# Offer workflow stays off until staging tests pass. Do not enable this in production
# until the offer module is explicitly approved. Unset or false leaves every new
# offer API refused and does not migrate existing data.
OFFER_WORKFLOW_ENABLED=false